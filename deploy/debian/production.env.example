NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATA_DIR=/var/lib/innovation-week
LOCAL_AUTH_BYPASS=false

# Replace the hostname; do not include a trailing slash.
APP_ORIGIN=https://innovation.yourdomain.com
# Generate with: openssl rand -hex 48
SESSION_SECRET=REPLACE_WITH_YOUR_GENERATED_SECRET
# Exactly one reverse proxy: Nginx or Apache on this instance.
TRUST_PROXY=1
ADMIN_EMAILS=your.actual.email@nepgroup.com

MAIL_MODE=smtp
# Use the endpoint for the region where you configured SES.
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SES_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_SES_SMTP_PASSWORD
MAIL_FROM=innovation@your-verified-domain.com
