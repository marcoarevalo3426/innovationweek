# PostgreSQL 16, started locally in a separate terminal with npm run db:local.
DB_CLIENT=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=innovation_week
PGUSER=innovation
PGPASSWORD=innovation_local_only
PGSSLMODE=disable
DB_AUTO_MIGRATE=true
# For remote/AWS PostgreSQL use verify-full and a CA bundle instead:
# PGSSLROOTCERT=/etc/ssl/certs/aws-rds-global-bundle.pem
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
# Local development automatically opens as a test admin without email login.
# Set false and restart to test the email login flow locally.
LOCAL_AUTH_BYPASS=true
# console is local-only. Use smtp in production.
MAIL_MODE=console
ADMIN_EMAILS=admin@nepgroup.com
DATA_DIR=./data
# Optional shared storage/limits for an EC2 fleet; see deploy/autoscaling/README.md.
# Create the private bucket and operational rate-limit table before enabling these.
# IMAGE_STORAGE=s3
# S3_UPLOAD_BUCKET=your-private-bucket
# S3_UPLOAD_PREFIX=uploads/
# RATE_LIMIT_STORE=postgres
# SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=innovation@nepgroup.com
# Production only:
# NODE_ENV=production
# APP_ORIGIN=https://innovation.example.com
# SESSION_SECRET=replace-with-at-least-32-random-characters
# TRUST_PROXY=1
