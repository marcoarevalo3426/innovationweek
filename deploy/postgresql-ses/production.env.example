# PLANNING TEMPLATE: PostgreSQL support must be implemented first.
# The current application ignores DB_CLIENT and the PG* settings below.
# Do not use this template to claim that the existing SQLite app has migrated.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATA_DIR=/var/lib/innovation-week
LOCAL_AUTH_BYPASS=false
APP_ORIGIN=https://innovation.yourdomain.com
SESSION_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
TRUST_PROXY=1
ADMIN_EMAILS=your.actual.email@nepgroup.com

# Proposed adapter selection; requires application implementation.
DB_CLIENT=postgres
PGHOST=REPLACE_WITH_THE_LIGHTSAIL_DATABASE_ENDPOINT
PGPORT=5432
PGDATABASE=innovation_week
PGUSER=innovation_app
PGPASSWORD=REPLACE_WITH_THE_APPLICATION_DATABASE_PASSWORD
# The proposed adapter must explicitly read this certificate into its ssl.ca.
PGSSLROOTCERT=/etc/ssl/certs/aws-rds-global-bundle.pem

# SES SMTP is already supported by the current application.
MAIL_MODE=smtp
# Match the region of the verified identity and the SES SMTP credentials.
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_THE_SES_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_THE_SES_SMTP_PASSWORD
MAIL_FROM=your.verified.sender@nepgroup.com
