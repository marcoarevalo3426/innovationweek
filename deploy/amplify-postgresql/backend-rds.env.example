# For the existing Express API (connection A), not frontend build variables.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATA_DIR=/var/lib/innovation-week
LOCAL_AUTH_BYPASS=false
APP_ORIGIN=https://main.d3ha2gxpxiqxnu.amplifyapp.com
SESSION_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUST_PROXY=1
ADMIN_EMAILS=your.actual.email@nepgroup.com
DB_CLIENT=postgres
DB_AUTO_MIGRATE=false
PGHOST=REPLACE_WITH_THE_RDS_POSTGRESQL_ENDPOINT
PGPORT=5432
PGDATABASE=innovation_week
PGUSER=innovation_app
PGPASSWORD=REPLACE_WITH_THE_UNIQUE_APPLICATION_ROLE_PASSWORD
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/aws-rds-global-bundle.pem
MAIL_MODE=smtp
SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SES_SMTP_USERNAME
SMTP_PASS=REPLACE_WITH_SES_SMTP_PASSWORD
MAIL_FROM=your.verified.sender@nepgroup.com
